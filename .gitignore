# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Environment / secrets
.env
.env.local

# Data — keep the folders (via .gitkeep) but ignore contents
data/raw/*
data/processed/*
data/external/*
!data/**/.gitkeep

# Reports / generated figures
reports/figures/*
!reports/figures/.gitkeep

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/

# Testing / tooling caches
.pytest_cache/
.ruff_cache/

# Secrets — never commit tokens / credentials
github_token
kaggle_token
kaggle.json
*.token
*_token

